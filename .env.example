DATABASE_URL="postgresql://antonina:antonina_dev_password@localhost:5432/antonina_dev"
NEXTAUTH_SECRET="dev_secret_change_in_production"
NEXTAUTH_URL="http://localhost:3000"
# Senha do usuário admin (DONO) criado pelo seed.
# Obrigatória quando NODE_ENV=production; em desenvolvimento há um fallback local.
SEED_ADMIN_SENHA="trocar-esta-senha"
PAYMENT_PROVIDER="mock"
# Troque para "mercadopago" só quando MERCADOPAGO_ACCESS_TOKEN/WEBHOOK_SECRET reais (de teste ou
# produção) estiverem configurados — sem isso a app tenta falar com o gateway de verdade e falha.
MERCADOPAGO_ACCESS_TOKEN="TEST-substitua-pelo-token-de-teste-do-mercado-pago"
MERCADOPAGO_WEBHOOK_SECRET="substitua-pelo-segredo-de-assinatura-do-webhook"
